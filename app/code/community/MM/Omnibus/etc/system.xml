<config>
    <tabs>
        <mm_omnibus translate="label" module="mm_omnibus">
            <label>Omnibus Directive</label>
            <sort_order>300</sort_order>
        </mm_omnibus>
    </tabs>

    <sections>
        <mm_omnibus translate="label" module="mm_omnibus">
            <label>Omnibus Directive</label>
            <tab>mm_omnibus</tab>
            <frontend_type>text</frontend_type>
            <sort_order>100</sort_order>
            <show_in_default>1</show_in_default>
            <show_in_website>1</show_in_website>
            <show_in_store>1</show_in_store>

            <groups>
                <general translate="label">
                    <label>General Settings</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>10</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>1</show_in_store>

                    <fields>
                        <enabled translate="label">
                            <label>Enable Omnibus Compliance</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </enabled>

                        <reference_period translate="label">
                            <label>Reference Period (days)</label>
                            <frontend_type>text</frontend_type>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment>Number of days to look back for lowest price (default: 30)</comment>
                        </reference_period>

                        <cleanup_days translate="label">
                            <label>History Cleanup After (days)</label>
                            <frontend_type>text</frontend_type>
                            <sort_order>40</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <comment>Days to keep price history before cleanup</comment>
                        </cleanup_days>
                    </fields>
                </general>

                <frontend translate="label">
                    <label>Frontend Display</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>20</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>0</show_in_website>
                    <show_in_store>0</show_in_store>

                    <fields>
                        <price_box_selector translate="label comment">
                            <label>CSS Selector</label>
                            <comment>CSS selector of the price element the notice is placed next to (default: .price-box)</comment>
                            <frontend_type>text</frontend_type>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </price_box_selector>

                        <notice_position translate="label comment">
                            <label>Notice Position</label>
                            <comment>Where to place the notice relative to the selected element (default: After, outside the price box so the layout of the price does not change)</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>mm_omnibus/system_config_source_position</source_model>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </notice_position>
                    </fields>
                </frontend>

                <debug translate="label">
                    <label>Debug Settings</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>40</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>0</show_in_website>
                    <show_in_store>0</show_in_store>

                    <fields>
                        <enabled translate="label">
                            <label>Enable Debug Logging</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment>Log Omnibus operations to var/log/mm_omnibus.log</comment>
                        </enabled>
                    </fields>
                </debug>
            </groups>
        </mm_omnibus>
    </sections>
</config>
